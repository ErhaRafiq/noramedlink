# Nora MedLink: the one environment file for the whole project (Next.js and FastAPI).
# Copy to .env in the project root and fill in. Never commit .env.
# On Render, set the same names in the dashboard (render.yaml); there is no .env there.
# Everything else (limits, models, timeouts) is a default in backend/config.py.

# Database (PostgreSQL, required). On Render it is filled in automatically.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/noramedlink

# Sign-in. Without JWT_SECRET_KEY a random secret is used and everyone is signed out on restart.
JWT_SECRET_KEY=change-me-to-a-long-random-string
# Needed to create an admin account at signup. Empty: admin signup is closed.
ADMIN_INVITE_CODE=

# Addresses: where the website runs (CORS, Stripe return pages) and where Next.js reaches FastAPI.
FRONTEND_ORIGIN=http://localhost:3000
SERVER_API_URL=http://127.0.0.1:8000

# AI (optional; without a key the app uses its fixed rules). ONE key from any provider: Gemini (AIza...),
# OpenAI (sk-...) or Claude (sk-ant-...). The app recognises the provider from the key.
AI_API_KEY=
# 0 skips BioBERT (needs about 1 GB of memory); entity extraction then uses the fixed rules.
BIOBERT_ENABLED=1

# Payments: Stripe test mode (sk_test_...). Empty: online payment is off.
STRIPE_SECRET_KEY=
# whsec_... from `stripe listen` locally, or from the webhook endpoint in the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=

# Doctor verification: the admin's "Check on PMDC" asks the free public PMDC register (only the registration
# number is sent). 0 switches the lookup off; the admin can still mark a doctor verified by hand.
PMDC_LOOKUP_ENABLED=1
PMDC_LOOKUP_URL=https://hospitals-inspections.pmdc.pk/api/DRC/GetData

# Email (Resend): sign-up verification, forgot-password codes, appointment emails and reminders.
# Empty key: no email is sent and everything else works. The domain in EMAIL_FROM must be verified in Resend
# (SPF and DKIM records). Put the real key only in your own .env, never in this file or in git.
RESEND_API_KEY=
EMAIL_FROM=Nora MedLink <noreply@noramedlink.online>
# Optional: where replies go (EMAIL_FROM is a no-reply address).
EMAIL_REPLY_TO=

# Test runs only: 1 ignores every AI, Stripe, PMDC and email service, so tests never call an outside service.
DISABLE_PAID_SERVICES=
