# Nora MedLink: the one environment file for the whole project (Next.js and FastAPI).
# Copy to .env in the project root and fill in. Never commit .env.
# On Render, set the same names in the nora-shared environment group (render.yaml); there is no .env there.
# A blank value means "not set" and the default is used.

# ---------------------------------------------------------------- Database (PostgreSQL, required)
# On Render this is filled in from the database automatically.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/noramedlink

# ---------------------------------------------------------------- Sign-in
# Signs sign-in tokens. Without it a random secret is used and everyone is signed out on restart.
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Needed to create an admin account at signup. Empty: admin signup is closed.
ADMIN_INVITE_CODE=

# ---------------------------------------------------------------- Addresses
# Where the website runs: allowed by CORS, and where Stripe sends patients back after paying.
FRONTEND_ORIGIN=http://localhost:3000
# Where the Next.js server reaches FastAPI (server side only; the browser never calls FastAPI).
SERVER_API_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------- Uploaded reports
# Folder for uploaded files, relative to backend/. Free Render instances lose it on every restart.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# ---------------------------------------------------------------- AI and OCR (optional)
# Without a key the app uses its fixed rules and local OCR. Patient identifiers are removed first.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_SCAN_MODEL=gpt-4.1-mini
GROQ_API_KEY=
OCR_SPACE_API_KEY=
# BioBERT entity extraction needs about 1 GB of memory: set to 0 on small hosts (rules still run).
BIOBERT_ENABLED=1
BIOBERT_MODEL=d4data/biomedical-ner-all

# ---------------------------------------------------------------- Payments (Stripe Checkout)
# Test mode keys start with sk_test_; no real money moves. Empty: online payment is off.
STRIPE_SECRET_KEY=
# whsec_...: from `stripe listen` locally, or from the webhook endpoint in the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=
PAYMENT_CURRENCY=pkr

# ---------------------------------------------------------------- Test runs
# 1: ignore every AI, OCR.space and Stripe key, so tests never call an outside service.
DISABLE_PAID_SERVICES=

# ---------------------------------------------------------------- Optional tuning (defaults shown)
# RATE_LIMIT_DEFAULT=200/minute
# RATE_LIMIT_LOGIN=20/minute
# RATE_LIMIT_LOGIN_ACCOUNT=5/minute
# RATE_LIMIT_SIGNUP=5/minute
# RATE_LIMIT_UPLOAD=10/minute
# RATE_LIMIT_AI=10/minute
# RATE_LIMIT_ACCESS_CODE=10/minute
# RATE_LIMIT_PAYMENT=10/minute
# TRUSTED_PROXY_IPS=127.0.0.1,::1
# LOG_LEVEL=INFO
