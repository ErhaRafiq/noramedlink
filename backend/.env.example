DATABASE_URL="postgresql://postgres:password@localhost:5432/noramedlink"
FASTAPI_DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/noramedlink
JWT_SECRET_KEY=change-this-secret-key
JWT_ALGORITHM=HS256
FRONTEND_ORIGIN=http://localhost:3000
ACCESS_TOKEN_EXPIRE_MINUTES=480
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Optional. Patient data is only sent externally when these are configured.
OPENAI_API_KEY=
OPENAI_SCAN_MODEL=gpt-4.1-mini
OPENAI_FALLBACK_MODELS=gpt-4o-mini
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
OCR_SPACE_API_KEY=
BIOBERT_MODEL=d4data/biomedical-ner-all

# Admin signup requires this code.
ADMIN_INVITE_CODE=change-me-to-a-long-random-code
OTP_EXPIRY_MINUTES=5

# Signup OTP delivery (email). Codes are never logged; without SMTP the request fails with 503.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Nora MedLink
SMTP_USE_TLS=true
SMS_PROVIDER=
SMS_API_KEY=

# Rate limits (see backend/rate_limit.py). "<count>/<second|minute|hour|day>".
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_LOGIN=20/minute
RATE_LIMIT_LOGIN_ACCOUNT=5/minute
RATE_LIMIT_SIGNUP=5/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_AI=10/minute
RATE_LIMIT_ACCESS_CODE=10/minute
# Peers allowed to set X-Forwarded-For (the Next.js proxy). Comma-separated.
TRUSTED_PROXY_IPS=127.0.0.1,::1
# memory:// counts per process; use a shared store (e.g. redis://localhost:6379) with several workers.
RATE_LIMIT_STORAGE_URI=memory://

# Level for the backend's own nora.* loggers: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
