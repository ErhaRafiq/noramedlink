DATABASE_URL="postgresql://postgres:password@localhost:5432/noramedlink"
FASTAPI_DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/noramedlink
JWT_SECRET_KEY=change-this-secret-key
JWT_ALGORITHM=HS256
FRONTEND_ORIGIN=http://localhost:3000
ACCESS_TOKEN_EXPIRE_MINUTES=480
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Optional. Patient data is only sent externally when these are configured.
OPENAI_API_KEY=
OPENAI_SCAN_MODEL=gpt-4.1-mini
OPENAI_FALLBACK_MODELS=gpt-4o-mini
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
OCR_SPACE_API_KEY=
BIOBERT_MODEL=d4data/biomedical-ner-all

# Admin signup requires this code.
ADMIN_INVITE_CODE=NORA-MEDLINK-ADMIN-2026
OTP_EXPIRY_MINUTES=5
OTP_DEV_MODE=true

# Signup OTP delivery. Console fallback is for local development only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Nora MedLink
SMTP_USE_TLS=true
SIGNUP_OTP_ALLOW_CONSOLE_FALLBACK=true
SMS_PROVIDER=
SMS_API_KEY=
